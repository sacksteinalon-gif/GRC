generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) email String @unique name String role String createdAt DateTime @default(now()) }
model Entity { id String @id @default(cuid()) name String jurisdiction String }
model Risk { id String @id @default(cuid()) refCode String @unique title String category String status String inherentScore Int residualScore Int appetiteLevel String isOutsideAppetite Boolean ale Float? sle Float? aro Float? controls RiskControl[] requirements RiskRequirement[] incidents IncidentRisk[] issues IssueRisk[] vendors VendorRisk[] }
model Control { id String @id @default(cuid()) refCode String @unique name String type String frequency String designEffectiveness String operatingEffectiveness String overallEffectiveness String risks RiskControl[] issues IssueControl[] requirements ControlRequirement[] policies ControlPolicy[] tests ControlTest[] }
model ControlTest { id String @id @default(cuid()) controlId String result String testedAt DateTime control Control @relation(fields:[controlId],references:[id]) }
model Incident { id String @id @default(cuid()) refCode String @unique title String severity String status String doraReportable Boolean art19Deadline DateTime? customerImpact Int financialImpact Int downtimeMinutes Int ibsFlag Boolean thirdPartyFlag Boolean piiFlag Boolean occurredAt DateTime risks IncidentRisk[] vendors IncidentVendor[] }
model Issue { id String @id @default(cuid()) refCode String @unique title String source String severity String dueDate DateTime isOverdue Boolean status String risks IssueRisk[] controls IssueControl[] requirements IssueRequirement[] milestones IssueMilestone[] }
model IssueMilestone { id String @id @default(cuid()) issueId String title String dueDate DateTime complete Boolean issue Issue @relation(fields:[issueId],references:[id]) }
model Vendor { id String @id @default(cuid()) name String tier String ictService Boolean concentrationRisk Boolean country String risks VendorRisk[] incidents IncidentVendor[] dueDiligence DueDiligence[] }
model DueDiligence { id String @id @default(cuid()) vendorId String area String status String vendor Vendor @relation(fields:[vendorId],references:[id]) }
model Framework { id String @id @default(cuid()) code String @unique name String requirements Requirement[] }
model Requirement { id String @id @default(cuid()) frameworkId String parentId String? refCode String title String complianceStatus String framework Framework @relation(fields:[frameworkId],references:[id]) parent Requirement? @relation("RequirementTree",fields:[parentId],references:[id]) children Requirement[] @relation("RequirementTree") risks RiskRequirement[] controls ControlRequirement[] policies PolicyRequirement[] issues IssueRequirement[] }
model Policy { id String @id @default(cuid()) title String lifecycle String owner String version String attestations Int exceptions Int signOffs Int controls ControlPolicy[] requirements PolicyRequirement[] }
model KRI { id String @id @default(cuid()) name String domain String amberThreshold Float redThreshold Float unit String readings KRIReading[] }
model KRIReading { id String @id @default(cuid()) kriId String value Float rag String capturedAt DateTime kri KRI @relation(fields:[kriId],references:[id]) }
model Committee { id String @id @default(cuid()) name String cadence String chair String nextMeeting DateTime }
model OrProcess { id String @id @default(cuid()) name String ibs String owner String bcpStatus String gaps OrGap[] }
model OrGap { id String @id @default(cuid()) processId String title String severity String process OrProcess @relation(fields:[processId],references:[id]) }
model AuditEngagement { id String @id @default(cuid()) name String status String rating String findings AuditFinding[] }
model AuditFinding { id String @id @default(cuid()) engagementId String title String severity String engagement AuditEngagement @relation(fields:[engagementId],references:[id]) }
model AuditLog { id String @id @default(cuid()) actor String action String entityType String entityId String createdAt DateTime @default(now()) }
model Comment { id String @id @default(cuid()) entityType String entityId String body String author String createdAt DateTime @default(now()) }
model RiskControl { riskId String controlId String risk Risk @relation(fields:[riskId],references:[id]) control Control @relation(fields:[controlId],references:[id]) @@id([riskId,controlId]) }
model RiskRequirement { riskId String requirementId String risk Risk @relation(fields:[riskId],references:[id]) requirement Requirement @relation(fields:[requirementId],references:[id]) @@id([riskId,requirementId]) }
model IncidentRisk { incidentId String riskId String incident Incident @relation(fields:[incidentId],references:[id]) risk Risk @relation(fields:[riskId],references:[id]) @@id([incidentId,riskId]) }
model IncidentVendor { incidentId String vendorId String incident Incident @relation(fields:[incidentId],references:[id]) vendor Vendor @relation(fields:[vendorId],references:[id]) @@id([incidentId,vendorId]) }
model IssueRisk { issueId String riskId String issue Issue @relation(fields:[issueId],references:[id]) risk Risk @relation(fields:[riskId],references:[id]) @@id([issueId,riskId]) }
model IssueControl { issueId String controlId String issue Issue @relation(fields:[issueId],references:[id]) control Control @relation(fields:[controlId],references:[id]) @@id([issueId,controlId]) }
model IssueRequirement { issueId String requirementId String issue Issue @relation(fields:[issueId],references:[id]) requirement Requirement @relation(fields:[requirementId],references:[id]) @@id([issueId,requirementId]) }
model ControlRequirement { controlId String requirementId String control Control @relation(fields:[controlId],references:[id]) requirement Requirement @relation(fields:[requirementId],references:[id]) @@id([controlId,requirementId]) }
model ControlPolicy { controlId String policyId String control Control @relation(fields:[controlId],references:[id]) policy Policy @relation(fields:[policyId],references:[id]) @@id([controlId,policyId]) }
model PolicyRequirement { policyId String requirementId String policy Policy @relation(fields:[policyId],references:[id]) requirement Requirement @relation(fields:[requirementId],references:[id]) @@id([policyId,requirementId]) }
model VendorRisk { vendorId String riskId String vendor Vendor @relation(fields:[vendorId],references:[id]) risk Risk @relation(fields:[riskId],references:[id]) @@id([vendorId,riskId]) }
